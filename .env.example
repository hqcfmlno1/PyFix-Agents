# Primary model credentials
# Use one of GEMINI_API_KEY or GOOGLE_API_KEY for the Google/Gemini analyzer.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# DeepInfra / OpenAI-compatible key used by planner, repro, and coder models.
DEEPSEEK_API_KEY=

# Optional MCP server override.
PYFIX_MCP_SERVER_HOST=127.0.0.1
PYFIX_MCP_SERVER_PORT=8000

# Optional runtime toggles.
PYFIX_PLANNER_USE_MCP=0
PYFIX_CODER_USE_MCP=0
PYFIX_NON_INTERACTIVE=0
